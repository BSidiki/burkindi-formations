# Configuration pour le développement en LOCAL uniquement. Ne jamais utiliser ces valeurs en production.
# Copiée automatiquement vers .env par `npm run local:setup` (si .env n'existe pas).
DATABASE_URL=postgresql://burkindi:burkindi_local@localhost:5432/burkindi
DIRECT_URL=postgresql://burkindi:burkindi_local@localhost:5432/burkindi
REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=local_dev_access_secret_not_for_production
JWT_REFRESH_SECRET=local_dev_refresh_secret_not_for_production
ACCESS_TTL=15m
REFRESH_TTL_DAYS=30
COOKIE_DOMAIN=
COOKIE_SECURE=false
REFRESH_COOKIE_PATH=/auth/refresh
WEB_ORIGIN=http://localhost:3000
ADMIN_ALLOWED_IPS=127.0.0.1,::1,::ffff:127.0.0.1
LOGIN_MAX_ATTEMPTS=3
REFERRAL_RATE=0.15
FIDO_ENFORCE=false
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMe!2026
# Secret 2FA de démonstration : le code à 6 chiffres s'obtient avec `npm run local:totp`.
SEED_ADMIN_TOTP_SECRET=JBSWY3DPEHPK3PXP
