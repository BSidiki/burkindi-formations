FROM node:20-bookworm-slim
WORKDIR /app
ARG NEXT_PUBLIC_API_URL
ARG NEXT_PUBLIC_WS_URL
ARG NEXT_PUBLIC_WHATSAPP
ARG NEXT_PUBLIC_PAY_ORANGE
ARG NEXT_PUBLIC_PAY_MOOV
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL NEXT_PUBLIC_WS_URL=$NEXT_PUBLIC_WS_URL NEXT_PUBLIC_WHATSAPP=$NEXT_PUBLIC_WHATSAPP NEXT_PUBLIC_PAY_ORANGE=$NEXT_PUBLIC_PAY_ORANGE NEXT_PUBLIC_PAY_MOOV=$NEXT_PUBLIC_PAY_MOOV NEXT_TELEMETRY_DISABLED=1
COPY . .
RUN npm install --no-audit --no-fund \
 && npm run build -w @burkindi/shared-types \
 && npm run build -w @burkindi/web
ENV NODE_ENV=production
CMD ["npm", "run", "start", "-w", "@burkindi/web"]
