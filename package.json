{
  "name": "burkindi-formations-monorepo",
  "version": "1.0.0",
  "private": true,
  "packageManager": "npm@10.9.9",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "db:migrate": "npm run prisma:migrate -w apps/api",
    "db:seed": "npm run prisma:seed -w apps/api",
    "local:up": "docker compose -f docker-compose.local.yml up -d",
    "local:down": "docker compose -f docker-compose.local.yml down",
    "local:env": "node scripts/local/init-env.js",
    "local:db": "node --env-file=.env node_modules/prisma/build/index.js db push --schema apps/api/prisma/schema.prisma",
    "local:seed": "node --env-file=.env -r ts-node/register apps/api/prisma/seed.ts && node --env-file=.env -r ts-node/register apps/api/prisma/seed.local.ts",
    "local:generate": "node node_modules/prisma/build/index.js generate --schema apps/api/prisma/schema.prisma",
    "local:setup": "npm run local:env && npm run build -w @burkindi/shared-types && npm run local:generate && npm run local:db && npm run local:seed",
    "local:totp": "node --env-file=.env scripts/local/totp.js"
  },
  "devDependencies": { "turbo": "^2.0.0", "typescript": "^5.4.0" },
  "engines": { "node": ">=20" }
}
